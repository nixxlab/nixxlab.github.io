---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { t, type Locale } from '../i18n/ui';
import { tagLabel, type Tag } from '../i18n/tags';
import { getPosts } from '../lib/content';

interface Props { locale: Locale; tag: Tag }
const { locale, tag } = Astro.props;
const posts = (await getPosts(locale)).filter((p) => p.data.tags.includes(tag));
const label = tagLabel(tag, locale);
---

<Base locale={locale} path={`/tags/${tag}/`} title={label}>
  <p class="muted">{t(locale, 'tag.title')}</p>
  <h1 class="tag-title">#{label}</h1>
  <PostList locale={locale} posts={posts} />
</Base>
