---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { localePath, t, type Locale } from '../i18n/ui';
import { tagLabel } from '../i18n/tags';
import { getPosts, getUsedTags } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const posts = await getPosts(locale);
const tags = await getUsedTags(locale);
---

<Base locale={locale} path="/">
  <h1>nixxlab</h1>
  <p class="muted">{t(locale, 'site.description')}</p>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => <li><a href={localePath(locale, `/tags/${tag}/`)}>#{tagLabel(tag, locale)}</a></li>)}
    </ul>
  )}
  <PostList locale={locale} posts={posts} />
</Base>
