---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { t, type Locale, type UiKey } from '../i18n/ui';
import { getPosts, slugOf, type Project } from '../lib/content';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const id = slugOf(project);
const { Content } = await render(project);
const posts = (await getPosts(locale)).filter((p) => p.data.project === id);
const { title, description, status, links } = project.data;
---

<Base locale={locale} path={`/projects/${id}/`} title={title} description={description}>
  <article>
    <h1 transition:name={`project-${id}`}>{title}</h1>
    <p class="muted">{t(locale, `project.status.${status}` as UiKey)}</p>
    <div class="prose"><Content /></div>
    {links.length > 0 && (
      <>
        <h2>{t(locale, 'project.links')}</h2>
        <ul>{links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
      </>
    )}
    {posts.length > 0 && (
      <>
        <h2>{t(locale, 'project.posts')}</h2>
        <PostList locale={locale} posts={posts} />
      </>
    )}
  </article>
</Base>
