---
/**
 * Skeleton of every page: semantic HTML, meta, hreflang, navigation.
 * The art layer holds the animated sky (Cosmos) and `<slot name="art" />` for a page's own art:
 * decorative, `aria-hidden`, kept across navigations (transition:persist).
 */
import { ClientRouter } from 'astro:transitions';
import { locales, htmlLang, ogLocale, localeLabel, localePath, t, type Locale } from '../i18n/ui';
import { site } from '../site';
import Cosmos from '../components/Cosmos.astro';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import cyrillic400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-cyrillic-400-normal.woff2?url';
import latin400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import '../styles/base.css';

interface Props {
  locale: Locale;
  /** Page path without the language prefix, e.g. "/blog/my-post/". */
  path: string;
  title?: string;
  description?: string;
  /** Languages the page exists in; by site rule, all three. */
  available?: readonly Locale[];
}

const { locale, path, title, description = t(locale, 'site.description'), available = locales } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(localePath(locale, path), Astro.site);
const alt = (l: Locale) => new URL(localePath(l, path), Astro.site).href;
// Active main-menu item: "page" on the section's own page, "true" inside the section (a post, a tag).
const section = path.startsWith('/projects/') ? '/projects/' : '/';
const current = (href: string) => (section !== href ? undefined : path === href ? 'page' : 'true');
// The body face of the page's script, fetched early so the text does not reflow when it arrives.
const bodyFont = locale === 'ru' ? cyrillic400 : latin400;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author[locale]} />
    <link rel="canonical" href={canonical.href} />
    {available.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt('ru')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} (${localeLabel[locale]})`} href={new URL(localePath(locale, '/rss.xml').replace(/\/$/, ''), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    {site.goatcounter && (
      <>
        {/* ClientRouter navigates without page loads, so count on every astro:page-load (initial load included). */}
        <script is:inline>
          if (!window.__gcTracking) {
            window.__gcTracking = true;
            window.goatcounter = { no_onload: true };
            const track = () => {
              const gc = window.goatcounter;
              if (gc && gc.count) gc.count({ path: location.pathname });
              else document.getElementById('goatcounter')?.addEventListener('load', track, { once: true });
            };
            document.addEventListener('astro:page-load', track);
          }
        </script>
        <script is:inline id="goatcounter" data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js" />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="art" aria-hidden="true" transition:persist="art"><Cosmos /><slot name="art" /></div>

    <header class="site-header">
      <a class="logo" href={localePath(locale, '/')}>nixxlab</a>
      <p class="tagline">{t(locale, 'site.description')}</p>
      <nav aria-label="main">
        <a href={localePath(locale, '/')} aria-current={current('/')}>{t(locale, 'nav.home')}</a>
        <a href={localePath(locale, '/projects/')} aria-current={current('/projects/')}>{t(locale, 'nav.projects')}</a>
      </nav>
      <nav class="langs" aria-label="language">
        {available.map((l) => (
          <a href={localePath(l, path)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === locale ? 'true' : undefined}>
            {localeLabel[l]}
          </a>
        ))}
      </nav>
    </header>

    {/* The page transition itself is in base.css (::view-transition-*(page)). */}
    <main transition:name="page">
      <slot />
    </main>

    <footer class="site-footer">
      <a href={localePath(locale, '/rss.xml').replace(/\/$/, '')}>RSS</a>
      {site.telegram && <a href={site.telegram}>Telegram</a>}
      {site.email && <a href={`mailto:${site.email}`}>Email</a>}
    </footer>
  </body>
</html>
